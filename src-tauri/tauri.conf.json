{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Third Street Bookmarks",
  "version": "1.2.0",
  "identifier": "com.thirdstreet.bookmarks",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "macOSPrivateApi": true,
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:",
        "img-src": "'self' data: blob: https: http://127.0.0.1:*",
        "media-src": "'self' data: blob: http://127.0.0.1:*",
        "connect-src": "'self' ipc: http://ipc.localhost http://127.0.0.1:* http://localhost:* https://api.elevenlabs.io https://api.sarvam.ai"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "Productivity",
    "shortDescription": "A local-first bookmark library",
    "longDescription": "Everything you bookmark \u2014 X, Hacker News, YouTube, Instagram and loose links \u2014 in one searchable, categorised, listenable library on your Mac, with AI features powered by the coding CLIs already on your machine.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../server": "server",
      "../python": "python"
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "dmg": {
        "background": "dmg/background.tiff",
        "windowSize": {
          "width": 660,
          "height": 516
        },
        "appPosition": {
          "x": 162,
          "y": 304
        },
        "applicationFolderPosition": {
          "x": 490,
          "y": 304
        }
      }
    }
  }
}
