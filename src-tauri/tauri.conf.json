{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Third Street Bookmarks",
  "version": "1.2.0",
  "identifier": "com.thirdstreet.bookmarks",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "macOSPrivateApi": false,
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline' https://fonts.googleapis.com",
        "font-src": "'self' data: https://fonts.gstatic.com",
        "img-src": "'self' data: blob: https: http://127.0.0.1:*",
        "media-src": "'self' data: blob: http://127.0.0.1:*",
        "connect-src": "'self' ipc: http://ipc.localhost http://127.0.0.1:* http://localhost:* https://api.elevenlabs.io https://api.sarvam.ai"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Productivity",
    "shortDescription": "A local-first X bookmark reader",
    "longDescription": "Browse, search, classify and listen to your X bookmarks locally, with AI features powered by the coding CLIs already on your machine.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../server": "server",
      "../python": "python"
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
